# Copy to server/.env and fill in. Never commit the real .env.
API_DOMAIN=api.srinagarbazaar.in
WEB_DOMAIN=srinagarbazaar.in
# Generate each with:  openssl rand -base64 36
DB_PASSWORD=
APP_SECRET=
ADMIN_TOKEN=
# console = codes appear in `docker compose logs api` (testing). Switch to msg91 or 2factor before launch.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWOFACTOR_API_KEY=
# Off-site backup (optional but strongly recommended): an rclone remote name, e.g. r2:srinagar-bazaar-backups
BACKUP_REMOTE=
