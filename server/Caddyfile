# Free automatic HTTPS (Let's Encrypt). Point your domain's A record at the VPS first.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}

# Kezia's Food API
{$KEZIA_DOMAIN} {
	encode zstd gzip
	reverse_proxy kezia:8090
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}
