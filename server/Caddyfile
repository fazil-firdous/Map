# Free automatic HTTPS (Let's Encrypt). Point your domain's A record at the VPS first.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}

# Kezia's Food API (all its addresses, comma-separated: its own domain and the old sslip.io one)
{$KEZIA_SITES} {
	encode zstd gzip
	reverse_proxy kezia:8090
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}
