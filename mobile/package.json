{
  "name": "srinagar-bazaar-app",
  "version": "1.0.0",
  "private": true,
  "description": "Srinagar Bazaar Android app (Capacitor)",
  "scripts": {
    "web": "node scripts/build-web.js",
    "sync": "node scripts/build-web.js && npx cap sync android",
    "assets": "npx capacitor-assets generate --android --iconBackgroundColor '#0D4F57' --iconBackgroundColorDark '#08353B' --splashBackgroundColor '#F6F8F8' --splashBackgroundColorDark '#0B1416'",
    "serve": "npx http-server www -p 8100 -c-1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "leaflet": "1.9.4",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "lucide-static": "^0.460.0"
  }
}
